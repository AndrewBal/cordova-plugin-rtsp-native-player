<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0"
        xmlns:android="http://schemas.android.com/apk/res/android"
        id="cordova-plugin-rtsp-native-player"
        version="1.0.0">

    <name>NativeRtspPlayer</name>
    <description>Native RTSP player for iOS and Android</description>
    <license>MIT</license>
    <keywords>cordova,rtsp,player,dashcam,ios,android,native</keywords>

    <js-module src="www/RtspHlsPlayer.js" name="RtspHlsPlayer">
        <clobbers target="window.RtspHlsPlayer" />
    </js-module>

    <platform name="android">
        <config-file target="res/xml/config.xml" parent="/*">
            <feature name="RtspHlsPlayer">
                <param name="android-package" value="com.andrewbal.rtspnativeplayer.RtspHlsPlayer" />
            </feature>
        </config-file>

        <config-file target="AndroidManifest.xml" parent="/manifest">
            <uses-permission android:name="android.permission.INTERNET" />
            <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
            <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
        </config-file>

        <config-file target="AndroidManifest.xml" parent="/manifest/application">
            <activity android:name="com.andrewbal.rtspnativeplayer.RtspNativePlayerActivity"
                      android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode"
                      android:screenOrientation="sensor"
                      android:theme="@style/RtspNativePlayerTheme"
                      android:exported="false" />
        </config-file>

        <source-file src="src/android/RtspHlsPlayer.java" target-dir="src/com/andrewbal/rtspnativeplayer" />
        <source-file src="src/android/RtspNativePlayerActivity.java" target-dir="src/com/andrewbal/rtspnativeplayer" />
        <resource-file src="src/android/res/values/rtsp_native_player_styles.xml" target="res/values/rtsp_native_player_styles.xml" />

        <framework src="androidx.media3:media3-exoplayer:1.3.1" />
        <framework src="androidx.media3:media3-exoplayer-rtsp:1.4.1" />
        <framework src="androidx.media3:media3-exoplayer-hls:1.4.1" />
        <framework src="androidx.media3:media3-ui:1.4.1" />
        <framework src="org.videolan.android:libvlc-all:3.6.0" />
    </platform>

    <platform name="ios">
        <config-file target="config.xml" parent="/*">
            <feature name="RtspHlsPlayer">
                <param name="ios-package" value="NativeRtspPlayerPlugin" />
            </feature>
        </config-file>

        <!-- Objective-C sources — -fmodules required for Network.framework C API -->
        <header-file src="src/ios/NativeRtspPlayerPlugin.h" />
        <source-file src="src/ios/NativeRtspPlayerPlugin.m" compiler-flags="-fmodules" />

        <header-file src="src/ios/RtspPlayerManager.h" />
        <source-file src="src/ios/RtspPlayerManager.m" compiler-flags="-fmodules" />

        <header-file src="src/ios/RtspClient.h" />
        <source-file src="src/ios/RtspClient.m" compiler-flags="-fmodules" />

        <header-file src="src/ios/RtpParser.h" />
        <source-file src="src/ios/RtpParser.m" compiler-flags="-fmodules" />

        <header-file src="src/ios/H264Decoder.h" />
        <source-file src="src/ios/H264Decoder.m" compiler-flags="-fmodules" />

        <header-file src="src/ios/HEVCDecoder.h" />
        <source-file src="src/ios/HEVCDecoder.m" compiler-flags="-fmodules" />

        <header-file src="src/ios/PlayerViewController.h" />
        <source-file src="src/ios/PlayerViewController.m" compiler-flags="-fmodules" />

        <!-- Frameworks -->
        <framework src="Network.framework" />
        <framework src="VideoToolbox.framework" />
        <framework src="AVFoundation.framework" />
        <framework src="CoreMedia.framework" />
        <framework src="CoreVideo.framework" />
    </platform>
</plugin>